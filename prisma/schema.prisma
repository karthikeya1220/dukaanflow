// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  RETAILER
  ORDER_DESK
}

enum ProductUnit {
  PIECE
  PACK
  CASE
}

enum PriceBasis {
  UNCONFIRMED
  PER_PACK
  PER_CASE
}

enum SchemeKind {
  BUY_X_GET_Y
  THRESHOLD_PERCENT
}

enum CartStatus {
  ACTIVE
  CONFIRMED
  SUBMITTED
}

enum OrderStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id          String   @id @default(cuid())
  authSubject String   @unique
  email       String   @unique
  role        UserRole
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  carts       Cart[]
  orders      Order[]
}

model Product {
  id            String      @id @default(cuid())
  sku           String      @unique
  name          String
  description   String?
  pricePaise    Int
  priceBasis    PriceBasis  @default(UNCONFIRMED)
  packSize      Int
  packUnit      ProductUnit
  sellingUnit   ProductUnit
  inventoryQty  Int
  inventoryUnit ProductUnit
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  schemes       Scheme[]
  cartLines     CartLine[]
  orderLines    OrderLine[]

  @@index([isActive, name])
}

model Scheme {
  id          String     @id @default(cuid())
  productId   String
  kind        SchemeKind
  buyQty      Int?
  freeQty     Int?
  minQty      Int?
  discountBps Int?
  isActive    Boolean    @default(true)
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, kind])
  @@index([productId, isActive])
}

model Cart {
  id                   String      @id @default(cuid())
  retailerId           String
  status               CartStatus  @default(ACTIVE)
  confirmedAt          DateTime?
  confirmedFingerprint String?
  submittedAt          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  retailer             User        @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  lines                CartLine[]
  order                Order?
}

model CartLine {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id                   String      @id @default(cuid())
  retailerId           String
  cartId               String      @unique
  idempotencyKey       String
  status               OrderStatus @default(SUBMITTED)
  submittedAt          DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  reservationExpiresAt DateTime
  inventoryReleasedAt  DateTime?
  rejectionReason      String?
  subtotalPaise        Int
  discountPaise        Int
  totalPaise           Int
  priceBasisConfirmed  Boolean
  isSimulation         Boolean     @default(false)
  reviewedByUserId     String?
  retailer             User        @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  cart                 Cart        @relation(fields: [cartId], references: [id], onDelete: Restrict)
  lines                OrderLine[]

  @@index([retailerId, submittedAt])
  @@index([status, reservationExpiresAt])
  @@unique([retailerId, idempotencyKey])
}

model OrderLine {
  id                String      @id @default(cuid())
  orderId           String
  productId         String?
  sku               String
  productName       String
  paidQty           Int
  freeQty           Int
  reservedQty       Int
  sellingUnit       ProductUnit
  inventoryUnit     ProductUnit
  unitPricePaise    Int
  priceBasis        PriceBasis
  grossPaise        Int
  discountPaise     Int
  totalPaise        Int
  schemeKind        SchemeKind?
  schemeId          String?
  schemeBuyQty      Int?
  schemeFreeQty     Int?
  schemeMinQty      Int?
  schemeDiscountBps Int?
  createdAt         DateTime    @default(now())
  order             Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}
