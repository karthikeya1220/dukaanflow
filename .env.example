# Local Supabase (npx supabase status) — copy to .env and fill.
# Prisma's prisma.config.ts loads this file via `import 'dotenv/config'`.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SITE_URL="http://127.0.0.1:3000"

# Documented reservation policy (no scheduler in v1; manual release runbook in TDD).
ORDER_RESERVATION_TTL_HOURS=24

# Required before tests that create or mutate local database fixtures.
TEST_DB_MUTATIONS="1"
TEST_DATABASE_NAME="postgres"
TEST_DATABASE_SCHEMA="public"

# OpenRouter-powered AI order capture (M7, implemented). Free models only.
AI_API_KEY=""            # OpenRouter API key (sk-or-...). Server-only; never exposed to the browser.
AI_MODEL="openrouter/free"  # OpenRouter auto-router: dynamically picks an available free-tier model. Paid models are never auto-selected.
AI_TIMEOUT_MS="30000"    # Optional hard request timeout in ms (default 20000).
# When AI_API_KEY is empty, order capture falls back to the labelled rule-based helper engine.
# Requests try JSON mode (response_format) and retry once without it for free models lacking structured output.